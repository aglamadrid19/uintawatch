{
  "expo": {
    "name": "Uinta Watch",
    "slug": "uintawatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uintawatch.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Uinta Watch needs your location to show nearby sensors and submit fire reports.",
        "NSCameraUsageDescription": "Uinta Watch needs camera access to take photos of fire sightings.",
        "NSPhotoLibraryUsageDescription": "Uinta Watch needs photo library access to attach images to fire reports.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "6GYGD7G5ZB",
      "buildNumber": "6"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C45A3B",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.uintawatch.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Uinta Watch needs your location to show nearby sensors and submit fire reports."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Uinta Watch needs photo library access to attach images to fire reports.",
          "cameraPermission": "Uinta Watch needs camera access to take photos of fire sightings."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "ca783830-cf35-4346-9099-3ab7ff324b76"
      },
      "router": {}
    },
    "scheme": "uintawatch",
    "owner": "alperper"
  }
}
