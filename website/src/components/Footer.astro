---
import { Image } from 'astro:assets';
import logo from '../assets/images/uinta-watch-logo.png';

const currentYear = new Date().getFullYear();
---

<footer class="bg-ink text-paper py-16">
  <div class="container">
    <!-- Statement section — asymmetric layout -->
    <div class="grid lg:grid-cols-12 gap-12 mb-12">
      <!-- Large statement text -->
      <div class="lg:col-span-7">
        <h2 class="text-display-lg text-paper mb-6">
          The ridges are watching.<br/>
          <span class="text-accent-light">Now it's your turn.</span>
        </h2>
        <p class="text-paper/50 max-w-md leading-relaxed">
          Open source wildfire detection. Built by Utahns, for Utah.
          Every sensor node is a neighbor.
        </p>
      </div>

      <!-- Links — asymmetric placement -->
      <div class="lg:col-span-5 lg:col-start-9 space-y-6">
        <div>
          <p class="eyebrow text-paper/50 mb-3">Navigate</p>
          <nav class="space-y-2">
            <a href="/about" class="block text-sm text-paper/80 hover:text-paper transition-colors duration-150">About</a>
            <a href="/sensors" class="block text-sm text-paper/80 hover:text-paper transition-colors duration-150">Sensors</a>
            <a href="/get-involved" class="block text-sm text-paper/80 hover:text-paper transition-colors duration-150">Get Involved</a>
          </nav>
        </div>
        <div>
          <p class="eyebrow text-paper/50 mb-3">Connect</p>
          <nav class="space-y-2">
            <!-- TODO: Replace with actual repository URL -->
            <a href="https://github.com" class="block text-sm text-paper/80 hover:text-paper transition-colors duration-150" target="_blank" rel="noopener noreferrer">GitHub</a>
            <!-- TODO: Replace with actual Discord invite URL -->
            <a href="https://discord.gg" class="block text-sm text-paper/80 hover:text-paper transition-colors duration-150" target="_blank" rel="noopener noreferrer">Discord</a>
            <a href="/support" class="block text-sm text-paper/80 hover:text-paper transition-colors duration-150">Support</a>
          </nav>
        </div>
        <div>
          <p class="eyebrow text-paper/50 mb-3">Legal</p>
          <nav class="space-y-2">
            <a href="/privacy" class="block text-sm text-paper/80 hover:text-paper transition-colors duration-150">Privacy Policy</a>
          </nav>
        </div>
        <a href="/get-involved" class="inline-flex items-center gap-2 mt-4 px-4 py-2 bg-accent text-accent-ink text-sm font-medium rounded hover:bg-accent-dark transition-colors duration-150">
          Join the Watch
        </a>
      </div>
    </div>

    <!-- Rule + footer row -->
    <div class="pt-8 border-t border-ink-soft flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <Image src={logo} alt="Uinta Watch logo" class="w-10 h-10 rounded-full object-cover" inferSize={false} />
        <p class="text-sm text-paper/60">
          &copy; {currentYear} <span translate="no">Uinta Watch</span> · MIT License
        </p>
      </div>
      <p class="text-xs text-paper/50">
        1.2 million acres burned in Utah since 2015.
      </p>
    </div>
  </div>
</footer>