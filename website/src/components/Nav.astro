---
import { Image } from 'astro:assets';
import logoNav from '../assets/images/logo-nav.png';

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/sensors', label: 'Sensors' },
  { href: '/open-questions', label: 'Open Questions' },
  { href: '/journal', label: 'Journal' },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur-md border-b border-paper-3">
  <nav class="container">
    <div class="flex items-center justify-between h-16">
      <!-- Wordmark -->
      <a href="/" class="flex items-center gap-3 group">
        <Image src={logoNav} alt="Uinta Watch logo" width={128} height={128} format="png" layout="fixed" class="h-16 w-16 shrink-0" loading="eager" />
        <span class="font-body text-xl font-medium text-ink">
          Uinta<span class="text-accent">Watch</span>
        </span>
      </a>

      <!-- Desktop nav — centered -->
      <div class="hidden md:flex items-center justify-center gap-8">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'text-base font-medium transition-colors duration-150',
              (pathname === link.href || pathname.startsWith(link.href + '/'))
                ? 'text-accent'
                : 'text-ink-soft hover:text-ink'
            ]}
          >
            {link.label}
          </a>
        ))}
        <a href="/get-involved" class="btn-primary text-sm py-2 px-4">
          Join the Watch
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="md:hidden p-2 -mr-2"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-menu-toggle
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div class="md:hidden hidden" id="mobile-menu" data-mobile-menu>
      <div class="py-4 border-t border-paper-3 space-y-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'block px-3 py-3 text-sm font-medium transition-colors duration-150 rounded',
              (pathname === link.href || pathname.startsWith(link.href + '/'))
                ? 'text-accent bg-paper-2'
                : 'text-ink-soft hover:text-ink hover:bg-paper-2'
            ]}
          >
            {link.label}
          </a>
        ))}
        <div class="pt-3 px-3">
          <a href="/get-involved" class="btn-primary w-full justify-center">
            Join the Watch
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  function initMobileMenu() {
    const toggle = document.querySelector('[data-mobile-menu-toggle]');
    const menu = document.querySelector('[data-mobile-menu]');

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', (!isOpen).toString());
        toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
      });
    }
  }

  document.addEventListener('astro:page-load', initMobileMenu);
</script>