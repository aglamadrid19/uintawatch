---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import solarSensorCloseup from '../assets/images/solar-sensor-closeup.png';

interface Device {
  partName: string;
  price: string;
  category: string;
  features: string[];
}

interface Sensor {
  partName: string;
  price: string;
  measures: string;
  role: string;
  highlight: boolean;
}

const devices: Device[] = [
  {
    partName: 'LILYGO T-Echo',
    price: '$35-70',
    category: 'Pre-Assembled',
    features: ['LoRa + GPS', 'NRF52 low-power chip', 'Grove I2C expansion', 'Battery-ready', 'Meshtastic firmware'],
  },
  {
    partName: 'LILYGO T-Beam Supreme',
    price: '$30-77',
    category: 'Pre-Assembled',
    features: ['LoRa + GPS', 'Optional cellular', 'Standard Meshtastic device', 'Larger form factor'],
  },
];

const sensors: Sensor[] = [
  { partName: 'BME688', price: '$35-50', measures: 'Temp, humidity, pressure, gas', role: 'Gas sensing (VOC/CO/H₂) — one input under test. Its value as an outdoor fire signal is unknown and being measured in public.', highlight: true },
  { partName: 'BME680', price: '$25-40', measures: 'Temp, humidity, pressure, gas', role: 'Alternative — lower cost with similar capability.', highlight: false },
  { partName: 'BME280', price: '$8-12', measures: 'Temperature, humidity, pressure', role: 'Baseline layer — plugs into Grove port, no soldering. Serves as the false-positive reference on some test nodes.', highlight: false },
];
---

<Layout title="Sensors" description="The sensor hardware behind Uinta Watch — LoRa mesh radios, environmental sensors, and solar power for open, off-grid environmental sensing.">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-ink rounded">Skip to content</a>
  <main id="main-content">

    <!-- Hero -->
    <section class="section-loose bg-paper border-b border-paper-3">
      <div class="container">
        <div class="max-w-3xl">
          <p class="eyebrow mb-6">Hardware Guide</p>
          <h1 class="text-display-xl text-ink mb-8">
            The sensor hardware<br/>
            <span class="text-accent">under test.</span>
          </h1>
          <p class="prose text-ink-soft text-xl leading-relaxed">
            Every sensor node has a LoRa radio and acts as both a sensing unit and a relay. Most nodes need no internet — a few gateway nodes bridge the mesh to it. What this hardware can and cannot detect is an open question we're answering in public.
          </p>
        </div>
      </div>
    </section>

    <!-- Base radio section -->
    <section class="section bg-paper">
      <div class="container">
        <div class="mb-12">
          <p class="eyebrow mb-4">Base Radio</p>
          <h2 class="text-display-lg text-ink mb-4">The Mesh Radio</h2>
          <p class="prose text-ink-soft max-w-xl">
            The base radio runs Meshtastic firmware — open source, configurable via phone app in minutes. Both work out of the box with no firmware compilation required.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6 mb-16">
          {devices.map(device => (
            <div class="card border-l-2 border-l-accent">
              <div class="flex items-start justify-between mb-4">
                <div>
                  <p class="eyebrow mb-1">{device.category}</p>
                  <h3 class="font-body font-semibold text-ink text-xl">{device.partName}</h3>
                </div>
                <span class="text-accent font-semibold whitespace-nowrap">{device.price}</span>
              </div>
              <ul class="space-y-2 mb-4">
                {device.features.map(f => (
                  <li class="flex items-center gap-2 text-sm text-ink-soft">
                    <svg class="w-4 h-4 text-success flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Sensors section -->
    <section class="section bg-paper-2">
      <div class="container">
        <div class="mb-12">
          <p class="eyebrow mb-4">Environmental Sensors</p>
          <h2 class="text-display-lg text-ink mb-4">What the Nodes Sense</h2>
          <p class="prose text-ink-soft max-w-xl">
            Environmental sensors track temperature, humidity, pressure, particulates, and gases. Published federal research shows ground smoke sensors can beat satellites at detecting night smoldering and contained-fire smoke — that's the niche we're testing with open hardware. All sensors plug into the Grove port — no soldering.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
          {sensors.map(sensor => (
            <div class:list={['card bg-paper border-l-2 border-l-accent', sensor.highlight ? 'border-t-2 border-t-accent' : '']}>
              {sensor.highlight && (
                <span class="inline-block px-2 py-0.5 bg-accent/10 text-accent text-xs font-semibold rounded mb-3">Recommended</span>
              )}
              <h3 class="font-body font-semibold text-ink text-xl mb-1">{sensor.partName}</h3>
              <p class="text-accent font-semibold whitespace-nowrap mb-4">{sensor.price}</p>
              <div class="space-y-4 text-sm">
                <div>
                  <p class="font-medium text-ink-muted mb-1">Measures</p>
                  <p class="text-ink-soft">{sensor.measures}</p>
                </div>
                <div>
                  <p class="font-medium text-ink-muted mb-1">Role</p>
                  <p class="text-ink-soft">{sensor.role}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Power section -->
    <section class="section bg-paper">
      <div class="container">
        <div class="grid lg:grid-cols-12 gap-12">
          <div class="lg:col-span-5">
            <p class="eyebrow mb-4">Power System</p>
            <h2 class="text-display-lg text-ink mb-6">Solar + Battery</h2>
            <p class="prose text-ink-soft mb-8">
              Every node runs completely off-grid. The battery autonomy target is 2-3 days without sunlight — though whether a solar node can survive a Utah winter unattended is one of our open questions. In Utah's climate, manageable with a modest panel.
            </p>
            <div class="space-y-4">
              {[
                ['5V/2A polycrystalline solar panel', '$10-15'],
                ['18650 3000mAh Li-ion battery', '$5-8'],
                ['TP4056 charge controller', '$1-2'],
                ['Weatherproof enclosure', '$5-15'],
              ].map(([item, cost]) => (
                <div class="flex justify-between items-center text-sm border-b border-paper-3 pb-3">
                  <span class="text-ink-soft">{item}</span>
                  <span class="font-medium text-ink">{cost}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="lg:col-span-6 lg:col-start-7">
            <div class="card">
              <h3 class="font-body font-semibold text-ink mb-6">Sample — Node Cost Breakdown</h3>
              <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                  <span class="text-ink-muted">LILYGO T-Echo</span>
                  <span class="whitespace-nowrap">$35-70</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-ink-muted">BME688 sensor</span>
                  <span class="whitespace-nowrap">$35-50</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-ink-muted">Solar + enclosure</span>
                  <span class="whitespace-nowrap">$15-25</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-ink-muted">Battery + charger</span>
                  <span class="whitespace-nowrap">$10-15</span>
                </div>
                <div class="pt-3 border-t border-paper-3 flex justify-between font-semibold text-lg">
                  <span>Total per node</span>
                  <span class="text-accent whitespace-nowrap">$85-150</span>
                </div>
              </div>
            </div>
            <div class="relative overflow-hidden mt-6" style="aspect-ratio: 3/4;">
              <Image
                src={solarSensorCloseup}
                alt="Weatherproofed solar-powered environmental sensor unit on Utah high desert stone"
                class="w-full h-full object-cover"
                width={600}
                height={800}
                loading="lazy"
                widths={[300, 600]}
                sizes="(max-width: 1024px) 100vw, 50vw"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/20 to-transparent"></div>
            </div>
            <p class="text-xs text-ink-muted mt-3 font-body">Solar-powered sensor unit in weatherproof enclosure</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>