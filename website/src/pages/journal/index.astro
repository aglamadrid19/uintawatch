---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal'))
  .filter(p => !p.id.endsWith('.draft'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="Lab Journal" description="The Uinta Watch lab journal — where we started, what we're changing and why, and every experiment result as it happens.">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-ink rounded">Skip to content</a>
  <main id="main-content">

    <!-- Hero -->
    <section class="section-loose bg-paper border-b border-paper-3">
      <div class="container">
        <div class="max-w-3xl">
          <p class="eyebrow mb-6">Lab Journal</p>
          <h1 class="text-display-xl text-ink mb-8">
            The process,<br/>
            <span class="text-accent">in public.</span>
          </h1>
          <p class="prose text-ink-soft text-xl leading-relaxed">
            Where we started, what we're changing along the way and why, and every experiment as it happens — including the results we'd rather not publish.
          </p>
        </div>
      </div>
    </section>

    <!-- Post list — editorial -->
    <section class="section bg-paper">
      <div class="container">
        <div class="max-w-3xl space-y-px bg-paper-3 border border-paper-3">
          {posts.map((post) => (
            <a href={`/journal/${post.id}/`} class="group block bg-paper hover:bg-paper-2 transition-colors duration-150 p-8">
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <time class="text-xs text-ink-muted" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                {post.data.tags.map(tag => (
                  <span class="px-2 py-0.5 bg-accent/10 text-accent text-xs font-medium rounded">{tag}</span>
                ))}
              </div>
              <h2 class="font-body font-semibold text-ink text-2xl mb-3 group-hover:text-accent transition-colors duration-150">
                {post.data.title}
              </h2>
              <p class="text-sm text-ink-soft leading-relaxed">{post.data.summary}</p>
              <span class="inline-block mt-4 text-xs font-medium text-accent group-hover:underline">Read entry</span>
            </a>
          ))}
          {posts.length === 0 && (
            <p class="prose text-ink-soft p-8">First entry coming soon.</p>
          )}
        </div>
      </div>
    </section>

    <!-- Subscribe -->
    <section class="section bg-paper-2 border-y border-paper-3">
      <div class="container text-center">
        <h2 class="text-display-lg text-ink mb-6 max-w-2xl mx-auto leading-tight">
          Follow the lab.
        </h2>
        <p class="prose text-ink-soft mx-auto mb-8">
          Entries are also available via <a href="/rss.xml" class="text-accent hover:underline">RSS</a>.
        </p>
      </div>
    </section>
  </main>
</Layout>
