---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroSensor from '../assets/images/hero-sensor.png';
import wildfireSky from '../assets/images/wildfire-sky.png';

const stats = [
  { number: '1.2M', label: 'Acres burned', context: 'Utah since 2015' },
  { number: '$240M', label: 'Firefighting costs', context: '2025 season' },
  { number: '180+', label: 'Structures destroyed', context: '2026 season' },
  { number: '3', label: 'On-duty firefighter deaths', context: '2026 season' },
];

const waysToParticipate = [
  {
    title: 'Run a Sensor',
    description: 'Pre-assembled units work straight out of the box. Configure with a phone app, mount with solar, join the network automatically.',
    href: '/get-involved#sensor',
  },
  {
    title: 'Build Your Own',
    description: 'Open-source designs for assemblers. We provide the instructions and parts list — beginner-friendly.',
    href: '/get-involved#build',
  },
  {
    title: 'Report What You See',
    description: 'When you see smoke, file a report through our app. What you see feeds the early warning system.',
    href: '/get-involved#report',
  },
  {
    title: 'Develop the Software',
    description: 'The entire platform is open source. React Native, Node.js, and firmware contributors welcome.',
    href: '/get-involved#code',
  },
];
---

<Layout title="Home" description="Uinta Watch is a community-driven, open-source early wildfire detection network. Solar-powered mesh sensors across Utah's wildlands — built by Utahns, for Utah.">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-ink rounded">Skip to content</a>
  <main id="main-content">

    <!-- Hero — asymmetric, typography-led -->
    <section class="section-loose bg-paper overflow-hidden">
      <div class="container">
        <div class="grid lg:grid-cols-12 gap-8 items-start">
          <!-- Left column — offset eyebrow -->
          <div class="lg:col-span-1">
            <div class="rule mt-2 hidden lg:block"></div>
          </div>

          <!-- Main content — not centered -->
          <div class="lg:col-span-6">
            <p class="eyebrow mb-6">Community Wildfire Detection</p>
            <h1 class="text-display-xl text-ink mb-8">
              Utah is burning.<br/>
              <span class="text-accent">Now it's your turn to watch.</span>
            </h1>
            <p class="prose text-ink-soft text-lg mb-10 leading-relaxed">
              Uinta Watch is a community-driven, open-source early wildfire detection network. Solar-powered mesh sensors across Utah's wildlands — built by Utahns, for Utah.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/get-involved" class="btn-primary justify-center">Join the Network</a>
              <a href="/about" class="btn-secondary justify-center">Learn More</a>
            </div>
          </div>

          <!-- Right column — editorial photography -->
          <div class="lg:col-span-5 lg:col-start-8">
            <div class="relative overflow-hidden" style="aspect-ratio: 4/3;">
              <Image
                src={heroSensor}
                alt="A solar-powered mesh sensor on a ridge in Utah canyon country at golden hour"
                class="w-full h-full object-cover"
                width={800}
                height={600}
                loading="eager"
                inferSize={false}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/30 to-transparent"></div>
            </div>
            <p class="text-xs text-ink-muted mt-3 font-body">Solar-powered sensor node, Utah canyon country</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats section — editorial grid -->
    <section class="section bg-paper-2 border-y border-paper-3">
      <div class="container">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
          {stats.map((stat) => (
            <div>
              <div class="stat-number">{stat.number}</div>
              <div class="font-body font-medium text-ink mt-1">{stat.label}</div>
              <p class="text-xs text-ink-muted mt-1">{stat.context}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Problem statement — asymmetric text block -->
    <section class="section bg-paper">
      <div class="container">
        <div class="grid lg:grid-cols-12 gap-8">
          <div class="lg:col-span-1">
            <p class="eyebrow hidden lg:block" style="writing-mode: vertical-rl; transform: rotate(180deg);">The Crisis</p>
          </div>
          <div class="lg:col-span-6">
            <h2 class="text-display-lg text-ink mb-8">
              The gap between smoke and response<br/>
              <span class="text-ink-soft">is measured in hours.</span>
            </h2>
          </div>
          <div class="lg:col-span-5">
            <div class="prose text-ink-soft space-y-4">
              <p>
                Utah's rural wildlands are vast. Cell towers don't reach every ridge. Satellites capture images hours old before they're processed.
              </p>
              <p>
                The first person to spot smoke is often a hiker, a rancher, a neighbor. There was no systematic way to get that information into the emergency network fast enough to matter.
              </p>
              <p class="text-ink font-medium">
                Uinta Watch exists to close that gap.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ways to participate — editorial card grid -->
    <section class="section bg-paper-2">
      <div class="container">
        <div class="mb-12">
          <p class="eyebrow mb-4">How to Help</p>
          <h2 class="text-display-lg text-ink">Every person is a node.</h2>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-paper-3">
          {waysToParticipate.map(way => (
            <a
              href={way.href}
              class="group block bg-paper-2 p-8 hover:bg-paper transition-colors duration-150"
            >
              <h3 class="font-body font-semibold text-ink group-hover:text-accent transition-colors duration-150 mb-3">
                {way.title}
              </h3>
              <p class="text-sm text-ink-muted leading-relaxed">{way.description}</p>
              <span class="inline-block mt-4 text-xs font-medium text-accent group-hover:underline">
                Learn more
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Editorial photography — full bleed wildfire image -->
    <section class="relative overflow-hidden" style="min-height: 70vh;">
      <Image
        src={wildfireSky}
        alt="Wildfire smoke column rising over Utah's mountain forest at dusk"
        class="absolute inset-0 w-full h-full object-cover"
        width={1920}
        height={1080}
        loading="lazy"
        inferSize={false}
      />
      <div class="absolute inset-0 bg-ink/50"></div>
      <div class="relative z-10 flex items-center justify-center" style="min-height: 70vh;">
        <div class="container text-center">
          <p class="eyebrow text-accent-ink/70 mb-6">The Reality</p>
          <h2 class="text-display-xl text-accent-ink mb-6 max-w-3xl mx-auto leading-tight">
            75% of Utah's wildfires<br/>are human-caused.
          </h2>
          <p class="text-accent-ink/80 max-w-xl mx-auto text-xl leading-relaxed">
            Early detection means resources reach the ignition point in minutes, not hours.<br/>
            That's the gap Uinta Watch exists to close.
          </p>
        </div>
      </div>
    </section>

    <!-- Statement section — full bleed accent -->
    <section class="section bg-accent">
      <div class="container text-center">
        <p class="eyebrow text-accent-ink/70 mb-4">The Network</p>
        <h2 class="text-display-lg text-accent-ink mb-6 max-w-2xl mx-auto leading-tight">
          Solar-powered. Mesh-connected. No cell towers required.
        </h2>
        <p class="text-accent-ink/80 max-w-xl mx-auto mb-8 leading-relaxed">
          Uinta Watch keeps working when everything else fails.
        </p>
        <a href="/get-involved" class="btn-primary justify-center" style="background-color: var(--color-paper); color: var(--color-ink);">
          Start Contributing
        </a>
      </div>
    </section>
  </main>
</Layout>