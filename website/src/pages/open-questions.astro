---
import Layout from '../layouts/Layout.astro';

interface Question {
  question: string;
  answer: string;
  source?: { label: string; href: string };
  status: 'measuring' | 'planned' | 'unknown';
}

const questions: Question[] = [
  {
    question: 'Can low-cost ground sensors detect outdoor fires at all?',
    answer: 'Yes — within limits. The first large field deployment of continuous ground smoke sensors (20 prescribed fires and wildfires, Canada 2023–2024) detected every fire over 100 hectares at median distances of ~1.5 km. Detection of fires ≤1 ha dropped to 30%.',
    source: { label: 'Fire (MDPI) 9(4):141, Jan 2026', href: 'https://www.mdpi.com/2571-6255/9/4/141' },
    status: 'measuring',
  },
  {
    question: 'Did DHS prove ground wildfire sensors don\'t work?',
    answer: 'DHS\'s own Inspector General found its contracted sensors (N5, 2020–2024) "did not consistently detect fires or provide early warning" — one sensor <100 ft from a fire alerted 30 minutes after dispatch, and wind direction caused misses. DHS ended the program. The same sensor class, used well in the Canadian study above, still delivered unique detections. The honest read: capability exists, but placement, wind, and verification are unsolved.',
    source: { label: 'DHS OIG-26-05, Apr 2026', href: 'https://www.oig.dhs.gov/reports/2026/dhs-wildfire-sensors-did-not-consistently-detect-fires-and-provide-early-warning/oig-26-05-apr26' },
    status: 'measuring',
  },
  {
    question: 'How far downwind can a $100 node detect a small ignition?',
    answer: 'No comparable open-hardware result exists yet. Controlled-burn demos with a BME688 + particulate sensor (BioBot project) detected smoke through obstruction at ~7 m; the DHS/NRCan networks detected large fires at 0.5–4.8 km. Where cheap open nodes fall in that range is exactly what we intend to measure.',
    source: { label: 'BioBot Project', href: 'https://biobotproject.org/' },
    status: 'measuring',
  },
  {
    question: 'Can multiple cheap nodes reduce false positives enough to matter?',
    answer: 'Promising but undemonstrated. The biggest identified false-positive source is far-field regional smoke drifting hundreds of kilometers — vendor event algorithms currently fail during regional smoke episodes. Multi-node corroboration plus wind data is our planned approach; no published number exists yet.',
    source: { label: 'Fire (MDPI) 9(4):141, Jan 2026', href: 'https://www.mdpi.com/2571-6255/9/4/141' },
    status: 'planned',
  },
  {
    question: 'Can Meshtastic deliver alerts dependably through mountain terrain?',
    answer: 'Unknown, and we treat it as an experiment rather than a guarantee. Meshtastic excels at off-grid community messaging, but public-safety-grade delivery guarantees through canyons and forest canopy have not been demonstrated. We\'ll publish packet-delivery data from every field test.',
    source: { label: 'Meshtastic', href: 'https://meshtastic.org/' },
    status: 'measuring',
  },
  {
    question: 'Can a solar-powered node survive a Utah winter unattended?',
    answer: 'Untested by us so far. Battery autonomy targets 2–3 days without sun; snow load, sustained inversion fog, and sensor aging are the known risks. Winter-survival trials are planned.',
    status: 'planned',
  },
  {
    question: 'Could our network ever beat cameras, satellites, and 911 at detecting a real wildfire?',
    answer: 'We don\'t claim it today. Satellites now deliver Ultra Real-Time fire detections in under 60 seconds for much of the US and Canada; camera networks like Pano AI already detect fires in Utah. If our instruments can\'t demonstrate earlier, unique, actionable detections in at least some repeatable circumstances, early detection stays a research track — never a promise.',
    source: { label: 'NASA FIRMS', href: 'https://firms.modaps.eosdis.nasa.gov/' },
    status: 'unknown',
  },
];

const statusMeta = {
  measuring: { label: 'Measuring now', cls: 'bg-accent/10 text-accent' },
  planned: { label: 'Planned', cls: 'bg-sky/10 text-sky' },
  unknown: { label: 'Open', cls: 'bg-ink/10 text-ink-soft' },
} as const;
---

<Layout title="Open Questions" description="The questions Uinta Watch exists to answer — with what published research already shows, and what we're measuring next.">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-ink rounded">Skip to content</a>
  <main id="main-content">

    <!-- Hero -->
    <section class="section-loose bg-paper border-b border-paper-3">
      <div class="container">
        <div class="max-w-3xl">
          <p class="eyebrow mb-6">Open Questions</p>
          <h1 class="text-display-xl text-ink mb-8">
            What we don't know<br/>
            <span class="text-accent">— and intend to find out.</span>
          </h1>
          <p class="prose text-ink-soft text-xl leading-relaxed">
            Low-cost wildfire sensing is full of impressive demos. These are the questions that decide which claims survive the field. Where research already has answers, we cite it. Where it doesn't, we say so — and measure.
          </p>
        </div>
      </div>
    </section>

    <!-- Questions list -->
    <section class="section bg-paper">
      <div class="container">
        <div class="max-w-3xl space-y-10">
          {questions.map((q, i) => (
            <div class="card border-l-2 border-l-accent">
              <div class="sm:flex sm:items-start sm:justify-between sm:gap-4">
                <h2 class="font-body font-semibold text-ink text-xl leading-snug min-w-0">
                  <span class="text-ink-muted font-normal mr-2">{String(i + 1).padStart(2, '0')}.</span>
                  {q.question}
                </h2>
                <span class:list={['shrink-0 inline-block px-2 py-0.5 mt-3 sm:mt-1 text-xs font-semibold rounded', statusMeta[q.status].cls]}>
                  {statusMeta[q.status].label}
                </span>
              </div>
              <p class="text-sm text-ink-soft leading-relaxed">{q.answer}</p>
              {q.source && (
                <p class="text-xs text-ink-muted mt-4">
                  Source: <a href={q.source.href} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">{q.source.label}</a>
                </p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Statement -->
    <section class="section bg-paper-2 border-y border-paper-3">
      <div class="container text-center">
        <h2 class="text-display-lg text-ink mb-6 max-w-2xl mx-auto leading-tight">
          Answers belong to everyone.
        </h2>
        <p class="prose text-ink-soft mx-auto mb-8">
          Every test result — positive or negative — is published with its raw data in the <a href="/journal" class="text-accent hover:underline">Lab Journal</a>, so anyone can verify, challenge, or build on it.
        </p>
      </div>
    </section>
  </main>
</Layout>
