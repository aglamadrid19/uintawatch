---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import communityNetwork from '../assets/images/community-network.png';
import runSensorNode from '../assets/images/run-sensor-node.png';
import sensorNodeBuild from '../assets/images/sensor-node-build.png';
import reportSmokeFire from '../assets/images/report-smoke-fire.png';
import developSoftware from '../assets/images/develop-software.png';
import educateOrganize from '../assets/images/educate-organize.png';
import deploySensor from '../assets/images/deploy-sensor.png';

interface Way {
  id: string;
  title: string;
  description: string;
  cta: string;
  href: string;
  external?: boolean;
  image: ImageMetadata;
  imageAlt: string;
}

interface OfferItem {
  number: string;
  label: string;
}

const ways: Way[] = [
  {
    id: 'sensor',
    title: 'Run a Sensor Node',
    description: 'Pre-assembled sensor units work straight out of the box. Configure with a phone app, mount with solar, join the network automatically. No engineering background needed.',
    cta: 'Request a Node',
    href: 'mailto:hello@uintawatch.com',
    image: runSensorNode,
    imageAlt: 'A person pairing a compact solar-powered mesh sensor node with a smartphone on a Utah ridge',
  },
  {
    id: 'build',
    title: 'Build Your Own',
    description: 'Open-source designs for community members who want to assemble their own sensor units. We provide instructions and parts list - beginner-friendly.',
    cta: 'View Build Guides',
    href: '/sensors',
    image: sensorNodeBuild,
    imageAlt: 'A workbench with a LoRa radio, gas sensor, solar panel, and battery being assembled into a sensor node',
  },
  {
    id: 'report',
    title: 'Report Smoke or Fire',
    description: 'When you see something, file a report through our app. What you see feeds the public sensor map and our research record. A neighbor spotting smoke early still makes the difference.',
    cta: 'Download the App',
    href: '/support',
    image: reportSmokeFire,
    imageAlt: 'A hiker on a canyon viewpoint holding a phone toward a distant smoke plume',
  },
  {
    id: 'code',
    title: 'Develop the Software',
    description: 'The entire platform is open source. React Native and Node.js developers can contribute. The more people who build and maintain sensors, the stronger the network.',
    cta: 'Contribute on GitHub',
    href: 'https://github.com/aglamadrid19/uintawatch',
    external: true,
    image: developSoftware,
    imageAlt: 'A developer at a desk at dusk, coding the sensor network dashboard',
  },
  {
    id: 'organize',
    title: 'Educate and Organize',
    description: 'Help neighbors and officials understand what Uinta Watch is and why it matters. Host a demo night. Talk to your local fire department.',
    cta: 'Get Materials',
    href: 'mailto:hello@uintawatch.com',
    image: educateOrganize,
    imageAlt: 'A volunteer demonstrating a sensor node to neighbors at a community demo night',
  },
  {
    id: 'deploy',
    title: 'Host or Deploy a Sensor',
    description: 'Host a test node on property you own or manage — a home, a ranch, a business. Strategic placements on public land require permits, so community-hosted nodes come first. Training and support provided.',
    cta: 'Host a Node',
    href: 'mailto:hello@uintawatch.com',
    image: deploySensor,
    imageAlt: 'A person mounting a weatherproof solar sensor node to a wooden post on a Utah ridgeline',
  },
];

const offering: OfferItem[] = [
  { number: '5-10', label: 'First pilot nodes' },
  { number: '~$150', label: 'Cost per node' },
  { number: '100%', label: 'Designs & data published' },
  { number: '24/7', label: 'Sensors never sleep' },
];
---

<Layout title="Get Involved" description="Run a sensor node, build your own, report smoke or fire, or contribute software. Every person in the network is a node.">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-ink rounded">Skip to content</a>
  <main id="main-content">

    <!-- Hero -->
    <section class="section-loose bg-paper border-b border-paper-3">
      <div class="container">
        <div class="max-w-3xl">
          <p class="eyebrow mb-6">Get Involved</p>
          <h1 class="text-display-xl text-ink mb-8">
            Every person in the network<br/>
            <span class="text-accent">is a node.</span>
          </h1>
          <p class="prose text-ink-soft text-xl leading-relaxed">
            Curiosity, a stake in Utah's wildlands, and a willingness to look out for your neighbors matter more than an engineering background.
          </p>
        </div>
      </div>
    </section>

    <!-- Editorial banner — mesh network aerial -->
    <section class="relative overflow-hidden" style="min-height: 55vh;">
      <Image
        src={communityNetwork}
        alt="Panoramic view of Utah's wildland terrain with distributed sensor nodes visible across a sweeping landscape"
        class="absolute inset-0 w-full h-full object-cover"
        width={1920}
        height={1080}
        loading="lazy"
        layout="full-width"
      />
      <div class="absolute inset-0 bg-ink/45"></div>
      <div class="relative z-10 flex items-center justify-center" style="min-height: 55vh;">
        <div class="container text-center">
          <p class="eyebrow text-accent-ink/70 mb-4">The Network</p>
          <h2 class="text-display-lg text-accent-ink mb-4">
            Every ridge has a neighbor on it.
          </h2>
          <p class="text-accent-ink/80 text-xl max-w-xl mx-auto">
            Solar-powered sensor nodes relay over a peer-to-peer mesh to a few internet gateways — off-grid by design.
          </p>
        </div>
      </div>
    </section>

    <!-- Ways section — editorial alternating layout -->
    <section class="section bg-paper">
      <div class="container">
        <div class="space-y-16">
          {ways.map((way, i) => (
            <div id={way.id} class="grid lg:grid-cols-12 gap-8 items-center scroll-mt-24">
              <!-- Content side -->
              <div class:list={['lg:col-span-6', i % 2 === 1 && 'lg:col-start-7']}>
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-10 h-10 rounded bg-accent/10 flex items-center justify-center">
                    <span class="font-body font-semibold text-accent text-lg">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                  </div>
                  <h2 class="text-display-md text-ink">{way.title}</h2>
                </div>
                <p class="prose text-ink-soft mb-6">{way.description}</p>
                <a
                  href={way.href}
                  class="btn-secondary"
                  {...(way.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {way.cta}
                </a>
              </div>

              <!-- Visual side — editorial photography -->
              <div class:list={['lg:col-span-4', i % 2 === 1 ? 'lg:col-start-1' : 'lg:col-start-8']}>
                <div class="relative overflow-hidden aspect-square border border-paper-3">
                  <Image
                    src={way.image}
                    alt={way.imageAlt}
                    class="absolute inset-0 w-full h-full object-cover"
                    width={800}
                    height={800}
                    loading="lazy"
                    widths={[400, 800]}
                    sizes="(max-width: 1024px) 100vw, 50vw"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-ink/20 to-transparent"></div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="section bg-paper-2 border-y border-paper-3">
      <div class="container">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
          {offering.map(item => (
            <div class="text-center">
              <div class="stat-number">{item.number}</div>
              <div class="text-sm text-ink-muted mt-1">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA section -->
    <section class="section bg-accent">
      <div class="container text-center">
        <h2 class="text-display-lg text-accent-ink mb-6 max-w-xl mx-auto">
          The first pilot nodes go up on land hosted by people like you — the network grows one node and one pair of watching eyes at a time.
        </h2>
        <a href="/get-involved" class="btn-primary justify-center" style="background-color: var(--color-paper); color: var(--color-ink);">
          Join the Community
        </a>
      </div>
    </section>
  </main>
</Layout>