---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import aftermathEmpty from '../assets/images/aftermath-empty.png';
---

<Layout title="About" description="How Uinta Watch works — an open-source, community-run early wildfire detection mesh network built by Utahns, for Utah.">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-ink rounded">Skip to content</a>
  <main id="main-content">

    <!-- Hero — editorial asymmetric -->
    <section class="section-loose bg-paper border-b border-paper-3">
      <div class="container">
        <div class="max-w-3xl">
          <p class="eyebrow mb-6">About the Project</p>
          <h1 class="text-display-xl text-ink mb-8">
            Built by the Community,<br/>
            <span class="text-accent">for the Community</span>
          </h1>
          <p class="prose text-ink-soft text-xl leading-relaxed">
            A community-driven early wildfire detection network. Put the tools for early detection in the hands of the people who are already out there.
          </p>
        </div>
      </div>
    </section>

    <!-- Story section — editorial layout -->
    <section class="section bg-paper">
      <div class="container">
        <div class="grid lg:grid-cols-12 gap-12">
          <div class="lg:col-span-7 space-y-10">
            <div>
              <h2 class="text-display-md text-ink mb-4">A Different Kind of Watch</h2>
              <div class="prose text-ink-soft space-y-4">
                <p>
                  Traditional fire detection systems are built top-down — government agencies purchase expensive equipment and wait for a signal. That's important. But it's not sufficient for a state as vast and varied as Utah.
                </p>
                <p>
                  There are gaps. There are ridges no tower reaches. There are communities in the wildland-urban interface where the first responder is always a neighbor.
                </p>
                <p>
                  Uinta Watch fills those gaps with community technology — open, redundant, and human. When a sensor detects abnormal heat, it notifies the nearest neighbor, the local fire department, and the volunteer network at the same time.
                </p>
              </div>
            </div>

            <div>
              <h2 class="text-display-md text-ink mb-4">Open Source, Open Access</h2>
              <div class="prose text-ink-soft space-y-4">
                <p>
                  Every design we publish is open source. Every sensor node can be repaired and modified by anyone. We don't believe in proprietary lock-in for public safety infrastructure.
                </p>
                <p>
                  Uinta Watch isn't dependent on any single organization, grant cycle, or vendor. It belongs to Utah.
                </p>
              </div>
            </div>
          </div>

          <!-- Right sidebar — asymmetric -->
          <div class="lg:col-span-4 lg:col-start-9 space-y-6">
            <div class="card">
              <h3 class="font-body font-semibold text-ink mb-4">Technical Approach</h3>
              <p class="text-sm text-ink-soft mb-4">
                Every sensor node has a LoRa radio and acts as both a sensing unit and a relay. A handful of gateway nodes bridge to the internet. The mesh is fully autonomous.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 bg-sky/10 text-sky text-xs font-medium rounded">LoRa Mesh</span>
                <span class="px-2 py-1 bg-accent/10 text-accent text-xs font-medium rounded">Meshtastic</span>
                <span class="px-2 py-1 bg-accent/10 text-accent text-xs font-medium rounded">Solar Powered</span>
              </div>
            </div>

            <div class="card">
              <h3 class="font-body font-semibold text-ink mb-4">Cost Per Node</h3>
              <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                  <span class="text-ink-muted">LILYGO T-Echo</span>
                  <span class="font-medium">$35-70</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-ink-muted">BME688 sensor</span>
                  <span class="font-medium">$25-40</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-ink-muted">Solar + enclosure</span>
                  <span class="font-medium">$15-25</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-ink-muted">Battery + controller</span>
                  <span class="font-medium">$10-15</span>
                </div>
                <div class="pt-3 border-t border-paper-3 flex justify-between font-semibold text-ink">
                  <span>Total</span>
                  <span class="text-accent">~$85-150</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial full-bleed image section -->
    <section class="relative overflow-hidden" style="min-height: 65vh;">
      <Image
        src={aftermathEmpty}
        alt="Scorched landscape in Utah after a wildfire, with a lone gutted home frame standing in the ash"
        class="absolute inset-0 w-full h-full object-cover"
        width={1920}
        height={1080}
        loading="lazy"
        inferSize={false}
      />
      <div class="absolute inset-0 bg-gradient-to-r from-ink/70 via-ink/40 to-transparent"></div>
      <div class="relative z-10 flex items-center" style="min-height: 65vh;">
        <div class="container">
          <div class="max-w-2xl">
            <p class="eyebrow text-accent-ink/70 mb-6">Why It Matters</p>
            <h2 class="text-display-lg text-accent-ink mb-6 leading-tight">
              The ash remains long after the flames die.
            </h2>
            <p class="text-accent-ink/80 text-xl leading-relaxed">
              Post-fire flooding, contaminated water supplies, displaced families.<br/>
              The consequences of uncaught fires last for years.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Phased plan — editorial grid -->
    <section class="section bg-paper-2">
      <div class="container">
        <h2 class="text-display-lg text-ink mb-12">The Phased Plan</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-paper-3">
          {[
            { phase: 'Phase 1', title: 'Pilot', nodes: '5-10 sensor nodes + 1 gateway', cost: '~$1,000-1,500', desc: 'Demonstrate feasibility in one area.' },
            { phase: 'Phase 2', title: 'Community', nodes: '20-50 sensor nodes, 3-5 gateways', cost: '~$4,000-7,000', desc: 'Build software dashboard. Register users.' },
            { phase: 'Phase 3', title: 'County', nodes: '100-300 nodes, 10-20 gateways', cost: '~$15,000-30,000', desc: 'Full dashboard, alert integrations, mobile app.' },
            { phase: 'Phase 4', title: 'Regional', nodes: 'Multi-county coverage', cost: 'Grant-dependent', desc: 'Partner with local fire departments.' },
          ].map(p => (
            <div class="card bg-paper-2 border-l-2 border-l-accent">
              <p class="eyebrow mb-2">{p.phase}</p>
              <h3 class="font-body font-semibold text-ink text-xl mb-2">{p.title}</h3>
              <p class="text-sm text-ink-muted mb-4">{p.desc}</p>
              <div class="text-xs text-ink-muted space-y-1">
                <p>{p.nodes}</p>
                <p class="font-semibold text-accent">{p.cost}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>